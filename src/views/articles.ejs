<!DOCTYPE html>
<html>
  <head>
    <title>Articles</title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <h1>Articles</h1>
    <a href="/">← Home</a>
    <% if (articles.length === 0) { %>
      <p>No articles found</p>
    <% } else { %>
      <ul class="list">
        <% articles.forEach(article => { %>
          <li>
            <a href="/articles/<%= article.id %>"><%= article.title %></a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </body>
</html>